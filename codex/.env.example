# Env vars for Discord-gated publishing (see README.md's "Discord-gated
# publishing" section). Copy this file to `.env` for local `vercel dev`, and
# set the same variables as Environment Variables in the Vercel project
# dashboard for deployed builds. Never commit `.env`.

# --- Discord application (discord.com/developers/applications) ---

# OAuth2 tab. Redirect URI to register there:
# https://<this-project's-vercel-domain>/api/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot tab of the same application — invite the bot to the guild below with
# just "View Channels" permission (no gateway intents needed; this only uses
# the REST API to read a single member's roles).
DISCORD_BOT_TOKEN=

# Server > Server Settings > Widget (enable it) to see the guild ID, or
# enable Developer Mode and right-click the server icon > Copy Server ID.
DISCORD_GUILD_ID=

# Two permission tiers, each a comma-separated list of Discord role IDs (Server
# Settings > Roles, Developer Mode on > right-click a role > Copy Role ID).
# Multiple role names can map to the same tier — e.g. both "Guild Member" and
# "Main Roster" go in DISCORD_AUTHOR_ROLE_IDS.
#
# author:     can create/edit/delete their own guides (Guild Member, Main Roster).
# moderator:  can create/edit/delete anyone's guides (Advisors, Monarchs) — a
#             strict superset of author.
DISCORD_AUTHOR_ROLE_IDS=
DISCORD_MODERATOR_ROLE_IDS=

# Random long string used to sign session cookies, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# --- Deployment topology ---
# The codex is served under a sub-path of a separate main site (e.g.
# quintessence-eu.com/guides/), while these /api/* functions live on this
# project's own Vercel domain — so both sides of that split need to know
# about each other. See README.md's "Why the cross-origin cookie/CORS
# plumbing exists" for the full explanation.

# The real, public URL the codex is mounted at, no trailing slash, e.g.
# https://quintessence-eu.com/guides — used to build the post-login redirect
# and to CORS-allow it.
PUBLIC_SITE_URL= "https://quintessence-eu.com/guides"

# This project's own absolute deployment origin, e.g.
# https://quintessence-codex.vercel.app — every /api/... call the browser
# makes is pointed here explicitly, since relative /api/... calls from a page
# served under PUBLIC_SITE_URL never reach this project's functions.
# Frontend-only: Vite only exposes env vars prefixed VITE_ to the browser.
VITE_API_ORIGIN= "https://quintessence-codex.vercel.app"

# --- GitHub (commits new/edited/deleted guides straight to this repo) ---

# Fine-grained PAT scoped to just this repo, with "Contents: Read and write"
# (preferred over a classic PAT).
GITHUB_TOKEN= 
GITHUB_OWNER=
GITHUB_REPO=
# Optional: defaults to the repo's default branch.
GITHUB_BRANCH= "main"
