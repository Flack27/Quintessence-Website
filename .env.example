# TBD according to quintessence decisions about discord management
# for login access. Those data are required in order to provide
# filtering and secure access for Quintessence players.

# Discord application (discord.com/developers/applications) — OAuth2 tab.
# Redirect URI to register there: https://<your-domain>/api/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot tab of the same application — invite the bot to the guild below with
# just "View Channels" permission (no gateway intents needed; this only uses
# the REST API to read a single member's roles).
DISCORD_BOT_TOKEN=

# Server > Server Settings > Widget (enable it) to see the guild ID, or
# enable Developer Mode and right-click the server icon > Copy Server ID.
DISCORD_GUILD_ID=
# Right-click the role in Server Settings > Roles (Developer Mode) > Copy Role ID.
DISCORD_REQUIRED_ROLE_ID=

# Random long string used to sign session cookies, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# GitHub token with "Contents: Read and write" on the repo below (a
# fine-grained PAT scoped to just this repo is recommended over a classic PAT).
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
# Optional: defaults to the repo's default branch.
GITHUB_BRANCH=
